generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JenisMotor {
  Konvensional
  Listrik
}

enum StatusServis {
  Dijadwalkan
  Selesai
}

model Servis {
  id         String       @id @default(uuid())
  kendaraan  String
  platNomor  String
  jenisMotor JenisMotor
  bengkel    String
  layanan    String
  biaya      Int
  tanggal    String
  status     StatusServis @default(Dijadwalkan)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("servis")
}
